# Firma del APK de SGP Movil (pe.gob.foncodes.sgp).
# Copia este archivo a  keystore.properties  (en la carpeta android/) y complete con los
# datos reales del keystore institucional
# keystore.properties y .jks ya estan en .gitignore.
#
# Ruta del keystore, relativa a la carpeta android/ (coloque el .jks ahi):
storeFile=sgp-movil-release.jks
storePassword=CAMBIAR
keyAlias=CAMBIAR
keyPassword=CAMBIAR
